# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-server-ip
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Database
DATABASE_URL=postgresql://progage_user:your-db-password@localhost:5432/progage_db
DB_PASSWORD=your-db-password

# Email settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_PROTO=True
RATE_LIMIT_ENABLED=True
RATE_LIMIT_GLOBAL_REQUESTS=600
RATE_LIMIT_AUTHENTICATED_REQUESTS=1200
RATE_LIMIT_API_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60

# Redis for websocket chat on production
REDIS_URL=redis://localhost:6379/0

# Runtime paths on Ubuntu
BACKUP_ROOT=/var/backups/progage
LOG_DIR=/var/log/progage
